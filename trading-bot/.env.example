# ─── Binance API (get from https://www.binance.com/en/my/settings/api-management) ───
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ─── Trading Mode ───────────────────────────────────────────────────────────────
# "paper"  = simulation (safe, start here)
# "live"   = real orders (use ONLY after 2 weeks paper trading success)
TRADING_MODE=paper

# Live arming phrase (required only when TRADING_MODE=live)
# Must exactly match LIVE_CONFIRMATION_REQUIRED_VALUE to allow live startup.
LIVE_CONFIRMATION_REQUIRED_VALUE=I_UNDERSTAND_LIVE_RISK
LIVE_CONFIRMATION_PHRASE=

# Live order type: market (default) or limit
LIVE_ORDER_TYPE=market

# WebSocket stream pressure control.
# First WS_MAX_SYMBOLS are processed via WS; remaining symbols are scanned via REST in background.
WS_MAX_SYMBOLS=6

# Signal anti-spam dedupe (same symbol+direction with near-identical score/price)
SIGNAL_DEDUP_COOLDOWN_SECONDS=1800
SIGNAL_DEDUP_MAX_SCORE_DELTA=2
SIGNAL_DEDUP_MIN_PRICE_MOVE_PCT=0.0015

# ─── Capital ────────────────────────────────────────────────────────────────────
# Your total trading budget in USDT
TOTAL_CAPITAL_USDT=1000

# ─── Watchlist (comma-separated Binance pairs) ──────────────────────────────────
WATCHLIST=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,ADA/USDT

# ─── Telegram Bot (get from @BotFather on Telegram) ──────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Database ───────────────────────────────────────────────────────────────────
DB_PATH=trading_bot.db

# Dashboard trade history scope:
# true  = show only trades opened/closed after API server startup
# false = show full historical trade DB on dashboard (default)
DASHBOARD_ONLY_CURRENT_SESSION=false
